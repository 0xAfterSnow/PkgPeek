# ── Core ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use a local SQLite file at data/pkguard.db.
# Set it in production, e.g. postgresql://user:pass@host/db
# DATABASE_URL=

# Override the SQLite path (used by the test suite).
# PKPEEK_DB_PATH=

# ── Admin panel ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
ADMIN_PASSWORD_HASH=
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────
FLASK_DEBUG=false
PORT=5000
# Set to 1 behind TLS so the session cookie is not sent over plain HTTP.
PKPEEK_SECURE_COOKIES=0
# Rate-limit storage. Use redis://... to share limits across workers.
LIMITER_STORAGE_URI=memory://

# ── Community reports ─────────────────────────────────────────────────────
# When both are set, reports are also filed as GitHub issues automatically.
# Without a token the UI offers a pre-filled issue link instead.
# GITHUB_REPO=0xaftersnow/pkgpeek
# GITHUB_TOKEN=

# ── Logo storage ─────────────────────────────────────────────────────────
# Where advertiser-submitted logos are stored. When BYTESHIP_API_KEY is set,
# uploads go to Byteship (https://byteship.dev) and are served from its CDN, so
# they survive a redeploy on an ephemeral host. Unset = store on local disk.
# Needs a project API key (bship_...) with the files:write scope.
# BYTESHIP_API_KEY=
# BYTESHIP_FOLDER=pkgpeek/logos

# ── Paid tool listings ────────────────────────────────────────────────────
# Hosted Dodo Payments checkout link. When unset, listings are disabled and the
# UI says so rather than rendering a broken checkout button.
DODO_TOOL_LISTING_PAYMENT_URL=
TOOL_LISTING_PRICE=
TOOL_LISTING_DURATION_DAYS=30
